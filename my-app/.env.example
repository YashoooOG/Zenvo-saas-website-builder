# Run bun run db:setup to generate .env.local with random local passwords.
# This template contains no usable credentials. Do not overwrite an existing
# .env.local or regenerate passwords for an already initialized Docker volume.
MYSQL_DATABASE=zenvo
MYSQL_USER=zenvo
MYSQL_PORT=3307
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generated shape: mysql://zenvo:<MYSQL_PASSWORD>@127.0.0.1:3307/zenvo
DATABASE_URL=

# Clerk, Stripe, and UploadThing variables will be documented in their stages.
# Store real credentials in .env.local or .env; never commit those files.

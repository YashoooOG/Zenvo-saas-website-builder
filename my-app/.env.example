# Run bun run db:setup to generate .env.local with random local passwords.
# This template contains no usable credentials. Do not overwrite an existing
# .env.local or regenerate passwords for an already initialized Docker volume.
MYSQL_DATABASE=zenvo
MYSQL_USER=zenvo
MYSQL_PORT=3307
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generated shape: mysql://zenvo:<MYSQL_PASSWORD>@127.0.0.1:3307/zenvo
DATABASE_URL=

# Clerk: copy both values from the SAME development instance in the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk webhook endpoint settings; different from CLERK_SECRET_KEY.
# Leave empty until configured. Unconfigured webhooks return 503, never accept data.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/agency
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/agency

# UploadThing v7: copy the token (not the legacy secret/app ID) from the dashboard.
# Agency logo files are public images. Use a development UploadThing app for tests.
UPLOADTHING_TOKEN=
# Stripe test/sandbox mode only. See docs/BILLING.md. Never use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Snapshot webhook signing secret for /api/stripe-webhook; leave empty until ready.
STRIPE_WEBHOOK_SECRET=
# Root hostname only, no scheme/port/path. Default localhost supports local testing.
ZENVO_ROOT_DOMAIN=localhost
# Store real credentials in .env.local or .env; never commit those files.

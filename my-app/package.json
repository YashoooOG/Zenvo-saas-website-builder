{
  "name": "zenvo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "node scripts/setup-database.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait --wait-timeout 180 mysql",
    "db:stop": "docker compose --env-file .env.local stop mysql",
    "db:status": "docker compose --env-file .env.local ps",
    "db:check": "node scripts/check-database.mjs",
    "test:db": "node --test scripts/database-config.test.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "test:auth": "node --test scripts/auth-routes.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fetch-cookie": "^3.2.0",
    "mysql2": "^3.24.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

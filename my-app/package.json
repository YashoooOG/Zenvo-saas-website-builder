{
  "name": "zenvo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrations": "prisma migrate status",
    "test:persistence": "bun --env-file=.env.local test scripts/persistence.test.ts",
    "test:agencies": "bun --env-file=.env.local test scripts/agencies.test.ts",
    "test:logos": "bun --env-file=.env.local test scripts/agency-logos.test.ts",
    "test:permissions": "bun --env-file=.env.local test scripts/permissions.test.ts",
    "test:invitations": "bun --env-file=.env.local test scripts/invitations.test.ts",
    "test:launchpad": "bun --env-file=.env.local test scripts/launchpad.test.ts",
    "test:subaccounts": "bun --env-file=.env.local test scripts/subaccounts.test.ts",
    "test:client-access": "bun --env-file=.env.local test scripts/client-access.test.ts",
    "test:media": "bun --env-file=.env.local test scripts/client-media.test.ts",
    "test:pipelines": "bun --env-file=.env.local test scripts/pipelines.test.ts",
    "media:cleanup": "bun --env-file=.env.local scripts/cleanup-media-assets.ts",
    "uploads:cleanup": "bun scripts/cleanup-logo-assets.ts",
    "test:webhook:http": "bun --env-file=.env.local test --timeout 30000 scripts/webhook-http.test.ts",
    "db:setup": "node scripts/setup-database.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait --wait-timeout 180 mysql",
    "db:stop": "docker compose --env-file .env.local stop mysql",
    "db:status": "docker compose --env-file .env.local ps",
    "db:check": "node scripts/check-database.mjs",
    "test:db": "node --test scripts/database-config.test.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "test:auth": "node --test scripts/auth-routes.test.mjs",
    "test:routing": "node --test scripts/tenant-routing.test.mjs",
    "test:routing:http": "node --test scripts/tenant-routes.test.mjs",
    "test:billing": "bun test scripts/billing.test.ts",
    "billing:check": "bun --env-file=.env.local scripts/check-billing.ts",
    "test:subscriptions": "bun --env-file=.env.local test scripts/subscriptions.test.ts",
    "test:checkout": "bun --env-file=.env.local test scripts/checkout.test.ts",
    "test:portal": "bun --env-file=.env.local test scripts/portal.test.ts",
    "test:reconciliation": "bun --env-file=.env.local test scripts/reconciliation.test.ts",
    "test:recovery": "bun --env-file=.env.local test scripts/recovery.test.ts",
    "billing:recover": "bun --env-file=.env.local scripts/recover-billing.ts",
    "test:connect": "bun --env-file=.env.local test scripts/connect.test.ts",
    "test:connect-oauth": "bun --env-file=.env.local test scripts/connect-oauth.test.ts",
    "test:connect-webhook": "bun --env-file=.env.local test scripts/connect-webhook.test.ts",
    "test:catalog": "bun --env-file=.env.local test scripts/connected-catalog.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-mariadb": "7",
    "@prisma/client": "7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fetch-cookie": "^3.2.0",
    "mysql2": "^3.24.6",
    "prisma": "7",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AgencyRole {
  ADMIN
  MEMBER
  CLIENT
}

enum SubAccountRole {
  ADMIN
  MEMBER
  GUEST
}

model User {
  // Clerk ID, not an email address. Deleted IDs remain as minimal tombstones.
  id String @id @db.VarChar(191)
  email String? @db.VarChar(320)
  name String? @db.VarChar(256)
  imageUrl String? @db.Text
  clerkUpdatedAt BigInt @default(0)
  deletedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  ownedAgencies Agency[]
  memberships AgencyMembership[]
}

model ClerkWebhookReceipt {
  id String @id @db.VarChar(191)
  type String @db.VarChar(64)
  receivedAt DateTime @default(now()) @db.DateTime(3)
}

model Agency {
  id String @id @default(cuid()) @db.VarChar(191)
  name String @db.VarChar(191)
  ownerId String @db.VarChar(191)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  logoUrl String? @db.Text
  logoKey String? @unique @db.VarChar(191)
  logoVersion Int @default(0)
  logoAssets AgencyLogoAsset[]
  businessEmail String? @db.VarChar(320)
  phone String? @db.VarChar(40)
  website String? @db.VarChar(2048)
  address String? @db.VarChar(256)
  city String? @db.VarChar(100)
  region String? @db.VarChar(100)
  postalCode String? @db.VarChar(32)
  country String? @db.VarChar(100)
  revision Int @default(0)
  creationKey String? @db.VarChar(36)
  stripeCustomerId String? @unique @db.VarChar(191)
  stripeConnectAccountId String? @unique @db.VarChar(191)
  subscriptions AgencySubscription[]
  checkout AgencyCheckout?
  billingRecoveries BillingRecoveryReceipt[]
  connectAttempts ConnectOAuthAttempt[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  memberships AgencyMembership[]
  subAccounts SubAccount[]
  invitations AgencyInvitation[]
  @@index([ownerId])
  @@unique([ownerId, creationKey])
}

model ConnectOAuthAttempt {
  id String @id @default(uuid()) @db.VarChar(36)
  agencyId String @db.VarChar(191)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ownerId String @db.VarChar(191)
  stateHash String @unique @db.Char(64)
  codeHash String? @unique @db.Char(64)
  clientId String @db.VarChar(191)
  callbackUrl String @db.VarChar(2048)
  status String @default("PENDING") @db.VarChar(16)
  accountId String? @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  expiresAt DateTime @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  @@index([agencyId, status, expiresAt])
}

model BillingRecoveryReceipt {
  id String @id @default(uuid()) @db.VarChar(36)
  agencyId String @db.VarChar(191)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ownerId String @db.VarChar(191)
  kind String @db.VarChar(16)
  objectId String @db.VarChar(191)
  fingerprint String @db.Char(64)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([agencyId, createdAt])
}

model AgencyCheckout {
  agencyId String @id @db.VarChar(191)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customerKey String @db.VarChar(36)
  customerStartedAt DateTime @default(now()) @db.DateTime(3)
  attemptKey String? @db.VarChar(36)
  attemptStartedAt DateTime? @db.DateTime(3)
  priceId String? @db.VarChar(191)
  origin String? @db.VarChar(2048)
  expiresAt Int?
  sessionId String? @unique @db.VarChar(191)
}

model AgencySubscription {
  id String @id @db.VarChar(191)
  agencyId String @db.VarChar(191)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  priceId String @db.VarChar(191)
  status String @db.VarChar(32)
  currentPeriodEnd DateTime @db.DateTime(3)
  cancelAtPeriodEnd Boolean
  collectionPaused Boolean
  syncedAt DateTime @default(now()) @db.DateTime(3)
  @@index([agencyId, syncedAt])
}

model StripeWebhookReceipt {
  id String @id @db.VarChar(191)
  type String @db.VarChar(64)
  receivedAt DateTime @default(now()) @db.DateTime(3)
}

enum LogoAssetStatus {
  PENDING
  ACTIVE
  RETIRED
  DELETED
}

model AgencyLogoAsset {
  id String @id @default(cuid()) @db.VarChar(191)
  agencyId String? @db.VarChar(191)
  actorId String @db.VarChar(191)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  fileKey String? @unique @db.VarChar(191)
  url String? @db.Text
  status LogoAssetStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([agencyId, status])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

model AgencyMembership {
  agencyId String @db.VarChar(191)
  userId String @db.VarChar(191)
  role AgencyRole @default(CLIENT)
  version String @default(uuid()) @db.VarChar(36)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  subAccounts SubAccountMembership[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@id([agencyId, userId])
  @@index([userId])
}

model AgencyInvitation {
  id String @id @default(cuid()) @db.VarChar(191)
  agencyId String @db.VarChar(191)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email String @db.VarChar(320)
  role AgencyRole
  tokenHash String @unique @db.Char(64)
  createdBy String @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  expiresAt DateTime @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  acceptedAt DateTime? @db.DateTime(3)
  acceptedBy String? @db.VarChar(191)
  @@index([agencyId, createdAt])
  @@index([agencyId, email])
}

model SubAccount {
  id String @id @default(cuid()) @db.VarChar(191)
  agencyId String @db.VarChar(191)
  name String @db.VarChar(191)
  subdomain String? @unique @db.VarChar(63)
  enabled Boolean @default(true)
  revision Int @default(0)
  creationKey String? @db.VarChar(36)
  logoUrl String? @db.Text
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberships SubAccountMembership[]
  invitations SubAccountInvitation[]
  pipelines Pipeline[]
  contacts Contact[]
  funnels Funnel[]
  media Media[]
  mediaAssets MediaAsset[]
  domains CustomDomain[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@unique([agencyId, id])
  @@unique([agencyId, creationKey])
}

model SubAccountMembership {
  agencyId String @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  userId String @db.VarChar(191)
  role SubAccountRole @default(GUEST)
  version String @default(uuid()) @db.VarChar(36)
  subAccount SubAccount @relation(fields: [agencyId, subAccountId], references: [agencyId, id], onDelete: Cascade)
  membership AgencyMembership @relation(fields: [agencyId, userId], references: [agencyId, userId], onDelete: Cascade)
  @@id([subAccountId, userId])
  @@index([agencyId, userId])
}

model SubAccountInvitation {
  id String @id @default(cuid()) @db.VarChar(191)
  agencyId String @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  subAccount SubAccount @relation(fields: [agencyId, subAccountId], references: [agencyId, id], onDelete: Cascade)
  email String @db.VarChar(320)
  role SubAccountRole @default(GUEST)
  tokenHash String @unique @db.Char(64)
  createdBy String @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  expiresAt DateTime @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  acceptedAt DateTime? @db.DateTime(3)
  acceptedBy String? @db.VarChar(191)
  @@index([agencyId, createdAt])
  @@index([subAccountId, email])
}

model Pipeline {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  name String @db.VarChar(191)
  archived Boolean @default(false)
  revision Int @default(0)
  creationKey String? @db.VarChar(36)
  subAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  lanes Lane[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@unique([subAccountId, id])
  @@unique([subAccountId, creationKey])
}

model Lane {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  pipelineId String @db.VarChar(191)
  name String @db.VarChar(191)
  position Int @default(0)
  pipeline Pipeline @relation(fields: [subAccountId, pipelineId], references: [subAccountId, id], onDelete: Cascade)
  tickets Ticket[]
  @@unique([subAccountId, pipelineId, id])
  @@index([subAccountId, pipelineId, position])
}

model Contact {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  name String @db.VarChar(191)
  email String? @db.VarChar(320)
  subAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  @@unique([subAccountId, id])
}

model Ticket {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  pipelineId String @db.VarChar(191)
  laneId String @db.VarChar(191)
  contactId String? @db.VarChar(191)
  title String @db.VarChar(191)
  description String? @db.Text
  position Int @default(0)
  value Decimal @default(0) @db.Decimal(19, 4)
  lane Lane @relation(fields: [subAccountId, pipelineId, laneId], references: [subAccountId, pipelineId, id], onDelete: Cascade)
  contact Contact? @relation(fields: [subAccountId, contactId], references: [subAccountId, id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([subAccountId, pipelineId, laneId, position])
  @@index([subAccountId, contactId])
}

model Funnel {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  name String @db.VarChar(191)
  subAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  pages FunnelPage[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@unique([subAccountId, id])
}

model FunnelPage {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  funnelId String @db.VarChar(191)
  name String @db.VarChar(191)
  path String @db.VarChar(191)
  draftContent Json
  publishedContent Json?
  publishedAt DateTime? @db.DateTime(3)
  funnel Funnel @relation(fields: [subAccountId, funnelId], references: [subAccountId, id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@unique([subAccountId, path])
  @@index([subAccountId, funnelId])
}

model Media {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  storageKey String @unique @db.VarChar(191)
  name String @db.VarChar(191)
  url String @db.Text
  mimeType String @db.VarChar(191)
  sizeBytes BigInt
  subAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([subAccountId])
}

model MediaAsset {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String? @db.VarChar(191)
  actorId String @db.VarChar(191)
  subAccount SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: SetNull)
  status LogoAssetStatus @default(PENDING)
  fileKey String? @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([subAccountId, status])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

model CustomDomain {
  id String @id @default(cuid()) @db.VarChar(191)
  subAccountId String @db.VarChar(191)
  hostname String @unique @db.VarChar(253)
  verifiedAt DateTime? @db.DateTime(3)
  subAccount SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  @@index([subAccountId])
}
